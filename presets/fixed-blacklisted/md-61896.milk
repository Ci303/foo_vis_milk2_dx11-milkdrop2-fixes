per_frame_init_1=prox = 1;
per_frame_1=chng=sin(time*0.54);
per_frame_2=cthr=.9999;
per_frame_3=mq21=if(above(chng,cthr),rand(3),mq21);
per_frame_4=mq22=if(above(chng,cthr),rand(3),mq22);
per_frame_5=mq23=if(above(chng,cthr),rand(3),mq23);
per_frame_6=mq24=if(above(chng,cthr),rand(2),mq24);
per_frame_7=mq25=if(above(chng,cthr),rand(2),mq25);
per_frame_8=mq26=if(above(chng,cthr),rand(2),mq26);
per_frame_9=mq27=if(above(chng,cthr),rand(1),mq27);
per_frame_10=mq28=if(above(chng,cthr),rand(1),mq28);
per_frame_11=mq29=if(above(chng,cthr),rand(1)*.3,mq29);
per_frame_12=mq31=if(above(chng,cthr),rand(1)*.3,mq31);
per_frame_13=monitor=chng;
per_frame_14=q21=mq21;q22=mq22;q23=mq23;q24=mq24;q25=mq25;q26=mq26;
per_frame_15=q27=mq27;q28=mq28;q29=mq29;q31=mq31;
per_frame_16=
per_frame_17=monitor=mq1;
per_frame_18=vol=bass+treb+mid;
per_frame_19=atime=atime+vol;
per_frame_20=q11=0.36+sin(atime*0.0057        )*0.36;
per_frame_21=q12=.4+cos(atime*.00613828348)*.4;
per_frame_22=q13=.4+sin(atime*.00598593455)*.4;
per_frame_23=monitor=q13;
per_frame_24=
per_frame_25=dec_med = pow (0.65, 30/fps);
per_frame_26=dec_slow = pow (0.874, 30/fps);
per_frame_27=//dec_xlow = pow (0.999, 30/fps);
per_frame_28=beat = max (max (bass, mid), treb); 
per_frame_29=avg = avg*dec_slow + beat*(1-dec_slow);
per_frame_30=is_beat = above(beat, .2+avg+peak) * above (time, t0+.2);
per_frame_31=t0 = is_beat*time + (1-is_beat)*t0;
per_frame_32=peak = is_beat * beat + (1-is_beat)*peak*dec_med;
per_frame_33=index = (index + is_beat) %32;
per_frame_34=index2 = (index2 + is_beat*bnot(index))%4;
per_frame_35=
per_frame_36=q22 = peak;
per_frame_37=q24 = is_beat;
per_frame_38=q26 = bass_att + mid_att + treb_att;
per_frame_39=vol = vol*dec_med + (1-dec_med)*q26;
per_frame_40=q27 = index + 1;
per_frame_41=q28 = index2 +1;
per_frame_42=
per_frame_43=p2 = .3*sin(time) + .3*cos(time/3);
per_frame_44=//*****tunnel tilting
per_frame_45=q1 = cos(p2 * 3.1416/4);
per_frame_46=q2 = sin(p2 * 3.1416/4);
per_frame_47=q3 = -q2;
per_frame_48=q4 = q1;
per_frame_49=
per_frame_50=//****tunnel viewpoint x,y
per_frame_51=vtrig = is_beat * bnot(index%2);
per_frame_52=vx = vx * bnot(vtrig) + vtrig * (int(rand(100))/100-.5);
per_frame_53=vy = vy * bnot(vtrig) + vtrig * (int(rand(100))/100-.5);
per_frame_54=vx = vx* below(index%15,5); //###
per_frame_55=vy = vy* below(index%15,5);
per_frame_56=q5 = vx*10;
per_frame_57=q6 = vy*12;
per_frame_58=
per_frame_59=//***tunnel width
per_frame_60=q21 = (1+sin(time/12))/8+.01;
per_frame_61=
per_frame_62=//**floor proximity
per_frame_63=prox = prox - above(vy,0.32)*prox*2;
per_frame_64=q32 = 0.53 + 0.24*prox;
per_frame_65=monitor = prox;
per_frame_66=
per_frame_67=//****tunnel rotation
per_frame_68=rota = rota +.01*below(index%16,8)/fps*30;
per_frame_69=rota1 = rota1*dec_med + (1-dec_med)*rota;
per_frame_70=q7 = rota1;
per_frame_71=
per_frame_72=//****tunnel speed
per_frame_73=movez = movez + 1.02/(1+abs(vx)+abs(vy))/fps;
per_frame_74=q8 = movez * (1+q21/4);
per_frame_75=//dyn. Aenderung von q21 bewirkt auch Richt.wechsel
per_frame_76=
per_frame_77=//***********************
per_frame_78=trig1= q24*bnot(index%12);
per_frame_79=trig2= q24*bnot((index+4)%12);
per_frame_80=trig3= q24*bnot((index+8)%12);
per_frame_81=trel = trel + vol/fps;
per_frame_82=z0 = 1;
per_frame_83=speed = vol/2;
per_frame_84=hx = sin(trel);
per_frame_85=hy = cos(trel);
per_frame_86=
per_frame_87=p1z = bnot(trig1)* (p1z + (5+p1z)*speed/fps)+trig1*z0;
per_frame_88=p1z = max(p1z,.1);
per_frame_89=q9 = hx/(p1z); 
per_frame_90=q10 = hy/(p1z); 
per_frame_91=q11 = p1z;
per_frame_92=q12 = .1+.02*q26*bnot((index+2)%3)*p1z*exp(-p1z/100);
per_frame_93=
per_frame_94=p2z = bnot(trig2)* (p2z + (5+p2z)*speed/fps)+trig2*z0;
per_frame_95=p2z = max(p2z,.1);
per_frame_96=q13 = 2*hx/(p2z); 
per_frame_97=q14 = -.5*hy/(p2z); 
per_frame_98=q15 = p2z;
per_frame_99=q16 = .1+.02*q26*bnot((index+2)%3)*p2z*exp(-p2z/100);
per_frame_100=
per_frame_101=
per_frame_102=p3z = bnot(trig3)* (p3z + (5+p3z)*speed/fps)+trig3*z0;
per_frame_103=p3z = max(p3z,0.09);
per_frame_104=q17 = -1.4*hx/(p3z); 
per_frame_105=q18 = 2*hy/(p3z); 
per_frame_106=q19 = p3z;
per_frame_107=q20 = .1+.02*q26*bnot((index+2)%3)*p3z*exp(-p3z/100);

