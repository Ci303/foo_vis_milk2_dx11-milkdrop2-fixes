per_frame_init_1=
per_frame_init_2=zoom=1;
per_frame_init_3=xpos=0;
per_frame_init_4=ypos=0;
per_frame_1=chng=sin(time*.5);
per_frame_2=cthr=.99;
per_frame_3=mq21=if(above(chng,cthr),rand(3),mq21);
per_frame_4=mq22=if(above(chng,cthr),rand(3),mq22);
per_frame_5=mq23=if(above(chng,cthr),rand(3),mq23);
per_frame_6=mq24=if(above(chng,cthr),rand(2),mq24);
per_frame_7=mq25=if(above(chng,cthr),rand(2),mq25);
per_frame_8=mq26=if(above(chng,cthr),rand(2),mq26);
per_frame_9=mq27=if(above(chng,cthr),rand(1),mq27);
per_frame_10=mq28=if(above(chng,cthr),rand(1),mq28);
per_frame_11=mq29=if(above(chng,cthr),rand(1),mq29);
per_frame_12=mq30=if(above(chng,cthr),rand(1),mq30);
per_frame_13=monitor=chng;
per_frame_14=q21=mq21;q22=mq22;q23=mq23;q24=mq24;q25=mq25;q26=mq26;
per_frame_15=q27=mq27;q28=mq28;q29=mq29;q30=mq30;
per_frame_16=
per_frame_17=monitor=mq1;
per_frame_18=decay=1;
per_frame_19=ob_r=1-abs(sin(time/2));
per_frame_20=ob_g=1-abs(sin(time/2));
per_frame_21=ob_b=1-abs(sin(time/2));
per_frame_22=ib_r=1-abs(cos(time/3));
per_frame_23=ib_g=1-abs(cos(time/3));
per_frame_24=ib_b=1-abs(cos(time/3));
per_frame_25=q1 = if(above(abs(ob_size - ib_size),0.06),17,0.8);
per_frame_26=ob_size=abs(sin(time/(5*q1))/13);
per_frame_27=ib_size=0.08-ob_size;
per_frame_28=volume = (bass_att+mid_att+treb_att)/3;
per_frame_29=beat_threshold = 1.7/((tb+tt)*0.5);
per_frame_30=time_threshold = 0.8;
per_frame_31=highpitch = 0.9 * treb_att + 0.1 * mid_att;
per_frame_32=lowpitch = bass_att;
per_frame_33=beat_bass = if(above(lowpitch,last_bass*beat_threshold),1,0);
per_frame_34=beat_treb = if(above(highpitch,last_treb*beat_threshold),1,0);
per_frame_35=timegap_bass = if(equal(beat_bass,1), (time-ltb), tgb);
per_frame_36=timegap_treb = if(equal(beat_treb,1), (time-ltt), tgt);
per_frame_37=tgb = timegap_bass;
per_frame_38=tgt = timegap_treb;
per_frame_39=last_time_bass = if(equal(beat_bass,1), time, ltb);
per_frame_40=last_time_treb = if(equal(beat_treb,1), time, ltt);
per_frame_41=ltb = last_time_bass;
per_frame_42=ltt = last_time_treb;
per_frame_43=tempo_bass = if(equal(beat_bass,1), (tb * 0.92 + 0.08 * tgb), tb);
per_frame_44=tempo_treb = if(equal(beat_treb,1), (tt * 0.92 + 0.08 * tgt), tt);
per_frame_45=tb = tempo_bass;
per_frame_46=tt = tempo_treb;
per_frame_47=q2 = beat_bass;
per_frame_48=q3 = beat_treb;
per_frame_49=q4 = ob_r;
per_frame_50=q5 = 1-ob_r;
per_frame_51=q6 = volume;
per_frame_52=
per_frame_53=
per_frame_54=
per_frame_55=
per_frame_56=
per_frame_57=
per_frame_58=
per_frame_59=
per_frame_60=
per_frame_61=monitor = tb;
per_frame_62=
per_frame_63=
per_frame_64=last_treb = highpitch;
per_frame_65=last_bass = lowpitch;
per_frame_66=rot=sin(time/5.3);
per_frame_67=beat = 0;
per_frame_68=dx= sin(time/4.4)/5;
per_frame_69=dy= cos(time/3.6)/5;
